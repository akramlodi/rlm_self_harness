# OpenRouter environment variables
OPENROUTER_API_KEY=

# Azure environment variables
AZURE_API_KEY=
AZURE_FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com

# Local/self-hosted OpenAI-compatible server (vLLM, Ollama, LM Studio, ...).
# A placeholder value (e.g. "ollama") is fine for servers that don't check it --
# shrlm still requires the variable to be present and non-empty.
VLLM_API_KEY=